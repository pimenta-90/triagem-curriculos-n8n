      "parameters": {
        "jsCode": "// Pega a vaga e os dados do candidato que está sendo processado agora\nconst candidato = $('Loop Over Items').first().json;\nconst vaga = candidato['Vaga pretendida'];\n\n// Requisitos vindos da aba Vaga\nconst linhasVaga = $input.all().map(item => item.json);\n\n// Confere se a coluna da vaga existe na aba Vaga\nif (!vaga || !(vaga in linhasVaga[0])) {\n  throw new Error(`Vaga não encontrada na aba Vaga: [${vaga}]`);\n}\n\n// Monta um texto com um requisito por linha\nconst requisitos = linhasVaga\n  .map(linha => `${linha['Campo']}: ${linha[vaga]}`)\n  .join('\\n');\n\nreturn [{ json: { vaga: vaga, requisitos: requisitos } }];"
      },
